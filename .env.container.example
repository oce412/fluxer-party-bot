# LOCAL CONTAINER TEST ONLY. Copy to .env.container and enter the private test bot's
# token and exact user ID. Do not commit .env.container or share its contents.
FLUXER_BOT_TOKEN=replace_with_your_private_test_bot_token
EXPECTED_BOT_USER_ID=replace_with_private_test_bot_user_id
# Disposable test database password only; use a URL-safe value (letters/numbers/hyphens).
POSTGRES_PASSWORD=partybot-container-test-change-me
LOCAL_HEALTH_PORT=3002
BOT_LANGUAGE=en
EVENT_DEFAULT_TIME_ZONE=UTC
LOG_LEVEL=info
