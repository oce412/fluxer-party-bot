# Local development ONLY. Use a separate Fluxer application/token from production.
APP_ENV=development
FLUXER_BOT_TOKEN=replace_with_your_development_bot_token
EXPECTED_BOT_USER_ID=
FLUXER_APPLICATION_ID=
BOT_LANGUAGE=en
EVENT_DEFAULT_TIME_ZONE=Europe/Moscow
DATA_DIR=data-development
HEALTH_PORT=3001
LOG_LEVEL=debug
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5
LANGUAGE_REQUEST_FORM_URL=
LANGUAGE_SUBMISSION_FORM_URL=
# Optional Markiplier Easter egg: once per UTC ISO week, a 1-in-100 chance to post one clip.
# Add a destination channel ID and comma/semicolon/newline-separated HTTPS clip URLs to enable it.
MARKIPLIER_CLIP_CHANNEL_ID=
MARKIPLIER_CLIP_URLS=
