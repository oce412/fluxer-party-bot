# Copy/configure this only in production hosting secret settings or an untracked local file.
APP_ENV=production
FLUXER_BOT_TOKEN=replace_with_your_production_bot_token
# Recommended: set this to the production bot USER ID to catch accidental wrong-token deployment.
EXPECTED_BOT_USER_ID=
FLUXER_APPLICATION_ID=
BOT_LANGUAGE=en
EVENT_DEFAULT_TIME_ZONE=UTC
DATA_DIR=data-production
# Use a separate production PostgreSQL database, never your development database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=5
# A hosting platform may provide PORT automatically. HEALTH_PORT takes precedence.
# Leave blank to inherit a hosting platform's PORT; set a number for a fixed port.
HEALTH_PORT=
LOG_LEVEL=info
LANGUAGE_REQUEST_FORM_URL=
LANGUAGE_SUBMISSION_FORM_URL=
